rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // VERSCHÄRFTE VARIANTE — erst aktivieren, nachdem die Datei
    // netlify/functions/auth.js erfolgreich eingerichtet ist (FIREBASE_SERVICE_ACCOUNT_JSON
    // und SESSION_SECRET als Netlify-Umgebungsvariablen gesetzt, Login über die Server-
    // Funktion im Browser getestet und funktionsfähig). Siehe DEPLOYMENT.md, Abschnitt
    // "Optional: maximale Sicherheit aktivieren".
    //
    // Unterschied zur einfachen firestore.rules: Das Dokument "appdata/users" (enthält
    // Benutzernamen, E-Mails und Passwort-Hashes) ist hier für JEDEN direkten Zugriff aus
    // dem Browser gesperrt — auch mit der öffentlich sichtbaren Firebase-Konfiguration kommt
    // niemand mehr direkt an diese Daten heran. Nur die Server-Funktion (die mit einem
    // privaten Service-Account-Schlüssel arbeitet, der die Regeln umgeht) darf noch lesen
    // und schreiben.
    //
    // WICHTIG: Wenn diese Regeln aktiv sind, OHNE dass die Server-Funktion richtig
    // eingerichtet ist, kann sich NIEMAND mehr an- oder abmelden oder registrieren, da der
    // Browser dann weder direkt noch über die Funktion an die Nutzerdaten kommt. Im
    // Zweifel zuerst mit der einfachen firestore.rules arbeiten, bis alles läuft.
    match /appdata/users {
      allow read, write: if false;
    }

    match /appdata/{document} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
